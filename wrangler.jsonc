{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "zaynab-studio",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-23",
  "assets": {
    "directory": "./app",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "APP_VERSION": "4.1",
    "ALLOW_REAL_GPU": "false"
  }
}
